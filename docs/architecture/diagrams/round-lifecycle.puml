@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial

title State-Driven AutoResearch Execution

participant "Runtime\nController" as Runtime
participant "Round\nManager" as Round
database "state.json" as State
collections "handoff.md" as Handoff
participant "Claude Code\nFresh Execution" as Claude
participant "Hooks" as Hooks
participant "Progress\nLedger" as Progress

Runtime -> State : load machine state
Round -> Progress : execution_started(id, time)
Round -> Handoff : read semantic state
Round -> Claude : prompt(state + handoff + docs)

loop strongly related experiments
  Claude -> Hooks : PreToolUse / PostToolUse
  Hooks -> State : flags, evidence indexes, signals
  Hooks --> Claude : allow, deny, observation
end

Claude -> Handoff : update next Execution state
Claude -> Hooks : Stop
alt handoff updated after Execution start
  Hooks --> Claude : allow Stop
else first stale handoff
  Hooks --> Claude : block once; request checkpoint
  Claude -> Handoff : externalize semantic state
  Claude -> Hooks : Stop again
  Hooks --> Claude : allow Stop
end

Claude --> Round : structured state output
Round -> State : reload and apply result
Runtime -> Progress : execution_completed(checkpoint status)

@enduml
