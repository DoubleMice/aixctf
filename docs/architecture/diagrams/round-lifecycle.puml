@startuml
!theme plain
hide footbox
scale max 1500 width

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam sequence {
  ArrowColor #475569
  ArrowThickness 2
  ArrowFontColor #334155
  ArrowFontSize 14
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #334155
  ParticipantFontColor #0F172A
  ParticipantFontSize 16
  ParticipantPadding 18
  GroupBorderColor #94A3B8
  GroupHeaderFontColor #0F172A
  GroupFontSize 16
}

title <size:30><b>State-Driven Execution Lifecycle</b></size>\n<size:17>A fresh Execution reads durable state, works freely, then commits the next state.</size>

participant "Runtime" as Runtime #DBEAFE
database "state.json\nMachine State" as State #DBEAFE
collections "handoff.md\nSemantic State" as Handoff #EDE9FE
participant "Claude Code\nFresh Execution" as Claude #FFEDD5
participant "Hooks" as Hooks #CCFBF1
participant "Execution\nLedger" as Ledger #E0F2FE

Runtime -> State : load machine state
Runtime -> Handoff : load semantic state
Runtime -> Ledger : execution_started(id, time)
Runtime -> Claude : launch(state + handoff + selected docs)

loop semantically coherent research
  Claude -> Hooks : PreToolUse / PostToolUse
  Hooks -> State : persist flags, evidence indexes, signals
  Hooks --> Claude : allow, deny, observation
end

Claude -> Handoff : update next Execution state
Claude -> Hooks : Stop
alt handoff updated after Execution start
  Hooks --> Claude : allow Stop
else first stale handoff
  Hooks --> Claude : block once; request checkpoint
  Claude -> Handoff : externalize semantic state
  Claude -> Hooks : Stop again
  Hooks --> Claude : allow Stop
end

Claude --> Runtime : structured state output
Runtime -> State : reload and apply result
Runtime -> Ledger : execution_completed(checkpoint status)

@enduml
