@startuml
!theme plain
hide footbox
scale max 1400 width

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam sequence {
  ArrowColor #475569
  ArrowThickness 2
  ArrowFontColor #334155
  ArrowFontSize 14
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #334155
  ParticipantFontColor #0F172A
  ParticipantFontSize 16
  ParticipantPadding 20
}

title <size:30><b>Bounded Task Handoff</b></size>\n<size:17>Local context-heavy work returns compact, durable evidence to the primary Execution.</size>

participant "Primary\nExecution" as Primary #FFEDD5
participant "Native Task\n(general-purpose)" as Task #FFF7ED
participant "PostToolUse\nHook" as Hook #CCFBF1
collections "Task Artifacts\ninput · output · result · handoff" as Artifacts #F1F5F9
database "state.json\nMachine State" as State #DBEAFE

Primary -> Task : bounded question + completion criteria
activate Task
Task -> Task : local experiment only
Task --> Primary : compact protocol JSON
deactivate Task

Primary -> Hook : PostToolUse(Task)
Hook -> Artifacts : persist task_XXX artifacts
Hook -> State : merge confirmed facts, open questions, do_not_repeat

note over Primary, State #EDE9FE
  The primary model decides what belongs in challenge-level handoff.md.
end note

@enduml
